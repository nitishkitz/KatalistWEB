VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Firebase Admin service-account JSON (plain or base64-encoded). Required for
# server-to-Chrome push delivery; the public VAPID key alone cannot send pushes.
FIREBASE_SERVICE_ACCOUNT=
VITE_KATALIST_DEMO_MODE=false
# Google Contacts: enable People API and create a Web OAuth client in Google Cloud.
# Add GOOGLE_CONTACTS_ORIGIN as its authorized JavaScript origin AND redirect URI.
# The client secret must remain server-only. Sync is read-only and user initiated.
VITE_GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
# Exact origin, no trailing slash; e.g. https://katalist-web.vercel.app
GOOGLE_CONTACTS_ORIGIN=
# Optional local-only OTP for development. Ignored by production builds.
# VITE_KATALIST_FIXED_OTP=111111
# Off until supabase/migrations/20260923100000_morning_brief_receipts.sql
# is deployed and live-verified. Gates Morning Brief's automatic daily
# opening only; manual reopening is unaffected either way.
VITE_KATALIST_MORNING_BRIEF_AUTO_OPEN=false

# Production browsers reach Supabase through the same-origin /supabase proxy so ISPs that block
# *.supabase.co cannot break sign-in. Set to false to call Supabase directly.
# VITE_SUPABASE_PROXY=false

# Code Activity UI preview. Enabled by default in npm run dev; false opts out.
# Always disabled in production builds, regardless of this flag.
# Shows the Code Activity tab as an honest "not configured" shell. It shows no sample data and makes no GitHub, AI, or database request.
VITE_CODE_ACTIVITY_PREVIEW=false

# Manual QA (see output/manual-qa-mockup/SONNET_COMPLETION_REPORT.md).
# Show the QA tab. Defaults to on in development and off in production builds. Turn on only after the
# QA migration is applied and, for stored passwords, the vault keys below are set.
# VITE_QA_ENABLED=
# Server-only vault keys for QA test-account passwords (AES-256-GCM). NEVER prefix with VITE_.
# QA_VAULT_KEYS is a JSON object of key version -> base64 of 32 random bytes, for example {"v1":"<base64>"}.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# QA_VAULT_KEYS=
# QA_VAULT_ACTIVE_KEY_VERSION=v1
# SUPABASE_SERVICE_ROLE_KEY (server-only, already used elsewhere) is also required for vault and evidence storage.
# CRON_SECRET guards /api/qa/evidence/cleanup (not scheduled by default).
